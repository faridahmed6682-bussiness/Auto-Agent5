# Server Port & Public URL (e.g. https://your-app.onrender.com or http://localhost:3000)
PORT=3000
PUBLIC_BASE_URL=

# Optional shared secret between TapPilot Android app and this backend (X-Bridge-Secret)
BRIDGE_SECRET=

# Google OAuth 2.0 Web Client Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized Redirect URI should be: <PUBLIC_BASE_URL>/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI Model API Keys (Supports multiple comma-separated keys for automatic rotation & failover)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional persistent volume root (Railway auto-detects RAILWAY_VOLUME_MOUNT_PATH automatically)
STORAGE_DIR=
